# ---------------------------------------------------------------------------
# PayGate configuration
# Copy this file to `.env` and adjust the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Public origin used in checkout links and webhook payloads.
# Set this in production (e.g. https://pay.example.com). When empty, the
# origin is derived from the incoming request.
PUBLIC_BASE_URL=https://pay.example.com

# SQLite database file (created automatically, WAL mode).
DATABASE_PATH=./data/paygate.db

# Admin API key for /api/admin/*. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=replace_with_a_long_random_secret

# Express "trust proxy" setting. Use 1 when behind a single reverse proxy
# (nginx, Caddy, Cloudflare) so rate limiting sees real client IPs.
TRUST_PROXY=1

# Checkout lifetime in seconds (60 - 604800). Default: 15 minutes.
PAYMENT_TTL_SECONDS=900

# Maximum accepted payment amount in BDT.
MAX_PAYMENT_AMOUNT_BDT=500000

# Webhook delivery worker
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=10
WEBHOOK_BATCH_SIZE=20
WEBHOOK_CONCURRENCY=5
WEBHOOK_WORKER_IDLE_MS=1000
WEBHOOK_RETENTION_DAYS=30
# Allow webhook URLs that resolve to private/loopback hosts. Keep false in
# production; enable only for local testing.
WEBHOOK_ALLOW_PRIVATE_URLS=false

# Retention for raw SMS events / unmatched SMS rows, in days.
SMS_RETENTION_DAYS=30

# In-memory per-IP rate limits
RATE_LIMIT_PUBLIC_PER_MIN=240
RATE_LIMIT_WEBHOOK_PER_MIN=600

# debug | info | warn | error | silent
LOG_LEVEL=info
